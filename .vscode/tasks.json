{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build OpenGL Project",
      "command": "/usr/bin/g++",
      "args": [
        "-std=c++17",
        "-g",
        "${workspaceFolder}/src/main.cpp",
        "${workspaceFolder}/src/gl.c",
        "-I${workspaceFolder}/ogldev/Include",
        "-o",
        "${workspaceFolder}/app",
        "-lglfw",
        "-lGL",
        "-ldl",
        "-lpthread"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}